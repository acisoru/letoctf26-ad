<!DOCTYPE html>
<html style="font-size: 16px;" class="u-responsive-xl"><head>
<meta http-equiv="content-type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="utf-8">
    <title>ToZeMun</title>
    <link rel="stylesheet" href="static/styles_.css" media="screen">
    <link id="u-theme-google-font" rel="stylesheet" href="static/css_002.css">
    <link id="u-page-google-font" rel="stylesheet" href="static/css.css">
    <link rel="stylesheet" href="static/styles.css">
    <style class="u-style">.u-section-2 {background-image: url("static/img/background.jpeg"); background-position: 50% 50%}
.u-section-2 .u-sheet-1 {min-height: 620px}
.u-section-2 .u-group-1 {
  width: 453px; min-height: 1000px; height: auto; margin: 0 0 0 auto
}
.u-section-2 .u-container-layout-1 {padding: 30px}
.u-section-2 .u-text-1 {font-size: 3rem; text-transform: none; font-weight: 400; margin: 20px 0 0}
.u-section-2 .u-text-2 {text-transform: uppercase; letter-spacing: 4px; font-size: 1.125rem; margin: 20px 0 0}
.u-section-2 .u-text-3 {margin: 20px auto 0 0}
.u-section-2 .u-btn-1 {border-style: solid; background-image: none; margin: 20px auto 0; padding: 10px 60px} 
@media (max-width: 1199px){ .u-section-2 .u-sheet-1 {min-height: 511px} }
@media (max-width: 991px){ .u-section-2 .u-sheet-1 {min-height: 391px} }
@media (max-width: 767px){ .u-section-2 {background-position: 85.86% 50%}
.u-section-2 .u-sheet-1 {min-height: 293px}
.u-section-2 .u-container-layout-1 {padding-left: 10px; padding-right: 10px} }
@media (max-width: 575px){ .u-section-2 .u-sheet-1 {min-height: 545px}
.u-section-2 .u-group-1 {min-height: 545px; margin-right: initial; margin-left: initial; width: auto}
.u-section-2 .u-text-1 {font-size: 2.25rem; margin-left: 21px; margin-right: 21px}
.u-section-2 .u-text-3 {margin-right: 0} }</style>
  
</head>
  <body class="u-body u-section-2">
    
    <section class="u-clearfix u-image">
      <div class="u-clearfix u-sheet u-sheet-1">
        <div class="u-align-center u-container-style u-expanded-width-xs u-group u-shape-rectangle u-group-1">
          <div class="u-container-layout u-valign-middle u-container-layout-1">
            <h2 class="u-text u-text-body-alt-color u-text-1"><b>Tu</b>Ze<b>Mun</b>
            </h2>
            <h5 class="u-text u-text-body-alt-color u-text-2">go right to the moon</h5>
            <p class="u-text u-text-body-alt-color u-text-default u-text-3" style="margin-bottom: 20px">We are an agency that fulfills the cherished dream of almost every living earthling - a flight to the moon in order to create a new colony of mankind. Apply for a flight right now:&nbsp;</p>
            <a id="signUpButton" class="u-border-2 u-border-white u-btn u-btn-round u-button-style u-none u-radius-30 u-text-hover-white u-btn-1">sign up</a>
            
            <a id="logInButton" class="u-border-2 u-border-white u-btn u-btn-round u-button-style u-none u-radius-30 u-text-hover-white u-btn-1">log in</a>
            
            <a id="resetButton" class="u-border-2 u-border-white u-btn u-btn-round u-button-style u-none u-radius-30 u-text-hover-white u-btn-1">forgot password</a>
          </div>
        </div>
      </div>
    </section>
    <div class="popupBackground" id="popupBackgroundSignup">
                <div class="popupContent" id="popupContentSignup">
                    <span class="closePopupButton" id="closePopupButtonSignup">&times;</span>
                    <h2>Registration</h2>
                    <form id="signUpForm">
                    <div class="rightText">
                    <label for="username">Username:</label>
                    <input class="inputField" type="text" id="usernameSignup" name="username" required><br><br>
                    
                    <label for="email">Email:</label>
                    <input class="inputField" type="email" id="emailSignup" name="email" required><br><br>
                    
                    <label for="password">Password:</label>
                    <input class="inputField" type="password" id="password1Signup" name="password" required><br><br>

                    <label for="password">Repeat password:</label>
                    <input class="inputField" type="password" id="password2Signup" name="password" required><br><br>
                    </div>
                    
                    <a id="submitSignup" class="u-border-2 u-border-white u-btn u-btn-round u-button-style u-none u-radius-30 u-text-hover-white u-btn-1" type="submit">Sign up</a>
                    </form>
                </div>
            </div>
    <div class="popupBackground" id="popupBackgroundLogin">
                <div class="popupContent" id="popupContentLogin">
                    <span class="closePopupButton" id="closePopupButtonLogin">&times;</span>
                    <h2>Log in</h2>
                    <form id="logInForm">
                    <div class="rightText">
                    <label for="username">Username:</label>
                    <input class="inputField" type="text" id="usernameLogin" name="username" required><br><br>
                    
                    <label for="password">Password:</label>
                    <input class="inputField" type="password" id="passwordLogin" name="password" required><br><br>
                    </div>

                    <a id="submitLogin" class="u-border-2 u-border-white u-btn u-btn-round u-button-style u-none u-radius-30 u-text-hover-white u-btn-1" type="submit">Log in</a>
                    </form>
                </div>
            </div>
      <div class="popupBackground" id="popupBackgroundReset">
                <div class="popupContent" id="popupContentReset">
                    <span class="closePopupButton" id="closePopupButtonReset">&times;</span>
                    <h2>Log in</h2>
                    <form id="resetForm">
                    <div class="rightText">
                    <label for="code">Code:</label>
                    <input class="inputField" type="text" id="codeReset" name="code" required><br><br>
                    
                    <label for="password">Password:</label>
                    <input class="inputField" type="password" id="passwordReset" name="password" required><br><br>
                    </div>

                    <a id="submitReset" class="u-border-2 u-border-white u-btn u-btn-round u-button-style u-none u-radius-30 u-text-hover-white u-btn-1" type="submit">Reset password</a>
                    </form>
                </div>
            </div>
</body>
<script src="static/api.js"></script>
<script src="static/main.js"></script>
</html>